# Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# API Configuration (for future web app integration)
VITE_API_BASE_URL=https://api.bridgitsocial.com
VITE_API_TIMEOUT=10000

# Authentication Endpoints (placeholder)
VITE_AUTH_ENDPOINT=/auth
VITE_LOGIN_ENDPOINT=/auth/login
VITE_SIGNUP_ENDPOINT=/auth/signup

# Feature Flags
VITE_ENABLE_WEB_APP=false
VITE_ENABLE_LOGIN=false
VITE_ENABLE_BLOG_COMMENTS=false

# Analytics — NOT actually wired to these Vite env vars. See docs/ANALYTICS_SETUP.md: the
# real Measurement ID lives in assets/js/analytics-config.js (a plain static file), not
# here — most of the site's pages (PrivacyPolicy/*, the two hand-written blog posts) are
# copied/served as raw static files rather than run through Vite's build, so a Vite-only
# env var wouldn't reach them. These two are kept as a placeholder in case a real
# build-time-templated config path gets added later; they do nothing today.
VITE_GA_MEASUREMENT_ID=
VITE_ENABLE_ANALYTICS=false

# Environment
VITE_ENVIRONMENT=development
